# API Configuration
# Local : http://localhost:8000/api — Production (Vercel) : https://api.kaho-auto-ecole.fr/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Même valeur que CRON_SECRET côté Railway — permet au cron Vercel de déclencher les rappels quotidiens
CRON_SECRET=

# Other environment variables
NEXT_PUBLIC_APP_NAME=Kaho

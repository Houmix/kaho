# ===== OBLIGATOIRE en production (Railway → Variables) =====
SECRET_KEY=change-me-long-random-string
DEBUG=False
# Domaines : site sur kaho-auto-ecole.fr (Vercel), API sur api.kaho-auto-ecole.fr (Railway)
ALLOWED_HOSTS=api.kaho-auto-ecole.fr,.up.railway.app
CORS_ALLOWED_ORIGINS=https://kaho-auto-ecole.fr,https://www.kaho-auto-ecole.fr
FRONTEND_URL=https://kaho-auto-ecole.fr
CSRF_TRUSTED_ORIGINS=https://api.kaho-auto-ecole.fr

# Compte administrateur créé automatiquement au déploiement
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=un-mot-de-passe-solide
ADMIN_FIRST_NAME=Prénom
ADMIN_LAST_NAME=Nom

# ===== Fourni automatiquement par Railway =====
# DATABASE_URL=postgresql://...   (ajouté quand la base Postgres est liée au service)
# PORT=...

# ===== OPTIONNEL =====
# Redis : sans lui, les tâches (emails) s'exécutent inline — suffisant pour démarrer
# REDIS_URL=redis://...
# Emails via Brevo SMTP (Brevo → SMTP & API → clés SMTP). Sans mot de passe, les emails vont dans les logs.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=email-de-connexion-brevo@exemple.fr
EMAIL_HOST_PASSWORD=cle-smtp-brevo
DEFAULT_FROM_EMAIL=Kaho <noreply@kaho-auto-ecole.fr>
# SMS via Brevo (Brevo → SMTP & API → onglet Clés API). Nécessite des crédits SMS sur le compte.
BREVO_API_KEY=
BREVO_SMS_SENDER=Kaho
# Paiement en ligne (pas encore branché)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stockage des documents sur Google Cloud Storage (sinon disque local — perdu à chaque déploiement Railway)
USE_GCS=False
GCS_BUCKET_NAME=kaho-documents
# Contenu du fichier JSON du compte de service (brut, ou encodé en base64 : base64 -i cle.json | tr -d '\n')
GCS_CREDENTIALS=
# Règles de réservation
BOOKING_MIN_NOTICE_HOURS=24
BOOKING_CANCEL_DEADLINE_HOURS=48

# ===== Développement local uniquement =====
DB_NAME=kaho_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

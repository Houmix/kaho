# ===== OBLIGATOIRE en production (Railway → Variables) =====
SECRET_KEY=change-me-long-random-string
DEBUG=False
# Domaine public du service Railway (Settings → Networking → Generate Domain)
ALLOWED_HOSTS=.up.railway.app,.railway.app
# URL du frontend Vercel (pour CORS et les liens dans les emails)
CORS_ALLOWED_ORIGINS=https://kaho-topaz.vercel.app
FRONTEND_URL=https://kaho-topaz.vercel.app
# URL publique du backend (pour l'admin Django en HTTPS)
CSRF_TRUSTED_ORIGINS=https://VOTRE-SERVICE.up.railway.app

# Compte administrateur créé automatiquement au déploiement
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=un-mot-de-passe-solide
ADMIN_FIRST_NAME=Prénom
ADMIN_LAST_NAME=Nom

# ===== Fourni automatiquement par Railway =====
# DATABASE_URL=postgresql://...   (ajouté quand la base Postgres est liée au service)
# PORT=...

# ===== OPTIONNEL =====
# Redis : sans lui, les tâches (emails) s'exécutent inline — suffisant pour démarrer
# REDIS_URL=redis://...
# Emails (sans clé, les emails sont affichés dans les logs)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@kaho.app
# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Paiement en ligne (pas encore branché)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stockage des documents (sinon disque local)
USE_GCS=False
GCS_BUCKET_NAME=
GCS_CREDENTIALS=
# Règles de réservation
BOOKING_MIN_NOTICE_HOURS=24
BOOKING_CANCEL_DEADLINE_HOURS=48

# ===== Développement local uniquement =====
DB_NAME=kaho_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

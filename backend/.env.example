# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.vercel.app

# Database
DB_NAME=kaho_db
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/kaho_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS + CSRF (mettre l'URL Vercel du frontend et l'URL Railway du backend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://kaho-topaz.vercel.app
CSRF_TRUSTED_ORIGINS=https://kaho-api.railway.app

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-key
DEFAULT_FROM_EMAIL=noreply@kaho.app

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+33123456789

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Google Cloud Storage
USE_GCS=False
GCS_BUCKET_NAME=kaho-documents
GCS_CREDENTIALS=path-to-service-account-json

# Magic Link Expiry (hours)
MAGIC_LINK_TOKEN_EXPIRY=24
